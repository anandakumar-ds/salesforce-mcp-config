# ================================================================
# ECC Revenue Router — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ================================================================

# --- HTTP server ---
PORT=8080
LOG_LEVEL=info
NODE_ENV=production

# --- Salesforce Connected App (OAuth 2.0 Client Credentials flow) ---
# Create at Setup > App Manager > ECC Revenue Router > "Manage Consumer Details"
SF_LOGIN_URL=https://ameyo.my.salesforce.com
SF_CLIENT_ID=replace-with-connected-app-consumer-key
SF_CLIENT_SECRET=replace-with-connected-app-consumer-secret
SF_API_VERSION=62.0

# --- Cache (LRU) ---
# phone -> context cache; tune based on call volume
CACHE_MAX_ITEMS=50000
CACHE_TTL_SECONDS=900

# --- Shared secret for IVR/CTI callers ---
# Rotate via secret manager. Clients MUST send `X-Router-Key: <value>`.
ROUTER_SHARED_KEY=generate-a-32-byte-random-hex-string

# --- Tier → queue mapping (overrides Queue_Config__mdt if set) ---
# Leave unset to read from Salesforce at startup.
# QUEUE_HYPERCARE=Hypercare_Support_Queue
# QUEUE_STRATEGIC=Strategic_Support_Queue
# QUEUE_PREMIUM=Premium_Support_Queue
# QUEUE_STANDARD=FLR_Support_Queue
